{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar at the bottom of your screen
  "height": 3, // Waybar height
  // the 10px gap is drawn inside the bar (style.css) so the drop shadow fits;
  // -10 on the window side keeps the space reserved for the bar unchanged
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": -10,

  // "width": 1366, // Waybar width
  // Choose the order of the modules
  // "modules-right": ["hyprland/window"],
  "modules-left": [
    "clock",
    "pulseaudio",
    "custom/audio",
    "custom/screenshot",
    "custom/cputemp",
    "custom/gputemp",
    "tray",
  ],
  "modules-right": ["battery","custom/lock","custom/suspend","custom/power"],
  "modules-center": ["ext/workspaces"],
  // ext/workspaces instead of hyprland/workspaces: the hyprland module switches workspaces
  // by sending old-style commands, which a Lua Hyprland config rejects, so clicking did nothing
  "ext/workspaces": {
    "on-click": "activate",
    "sort-by-name": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "𝕀",
      "2": "𝕀𝕀",
      "3": "𝕀𝕀𝕀",
      "4": "𝕀𝕍",
      "5": "𝕍",
      "6": "𝕍𝕀",
      "7": "𝕍𝕀𝕀",
      "8": "七",
      "9": "八",
      "10": "九",
    },
  },
  "hyprland/mode": {
    "format": "<span style=\"italic\">{}</span>",
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10,
  },
  "clock": {
    "format": "{:%H:%M %m/%d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "months": "<span color='#7abfff'><b>{}</b></span>",
        "today": "<span color='#7abfff'><b>{}</b></span>",
        //"tooltip-format": "{tz_list}",
        //"timezones": [
        //	"Asia/Tokyo",
        //	"Europe/London"
        //]
      },
    },
  },
  "cpu": {
    "format": "CPU",
  },
  "battery": {
    "format-discharging": "{}%",
    "format-plugged": "󱐌 {}%",
    "format-charging": "󱐌 {}%",
    "interval": 2,
  },
  "network": {
    // "interface": "wlp2s0", // (Optional) To force the use of this interface
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
    "format-disconnected": "Disconnected ⚠",
  },
  "pulseaudio": {
    //"scroll-step": 1,
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", ""],
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",

    //    },
    //    "temperature": {
    //        //"thermal-zone": 2,
    //        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
    //        "critical-threshold": 80,
    //        "format-critical": "{temperatureC}°C {icon}",
    //        "format": "{temperatureC}°C {icon}",
    //        //"format-icons": [""],
    //	"interval": 1
  },
"custom/cputemp": {
    "exec": "~/Dotfiles/scripts/cputemp.sh",
    "interval": 3,
    "format": "{}",
    "tooltip": false
  },
"custom/gputemp": {
    "exec": "~/Dotfiles/scripts/gputemp.sh",
    "interval": 3,
    "format": "{}",
    "tooltip": false
  },
  "custom/power": {
    "format": "\u2670",   // the ♰ cross from the fish greeting (same as the login screen)
    "tooltip": false,
    "on-double-click": "systemctl poweroff",
    // right-click: shut down after 30/45/60 min, or cancel (waybar/power_menu.xml)
    "menu": "on-click-right",
    "menu-file": "~/Dotfiles/waybar/power_menu.xml",
    "menu-actions": {
      "off30": "~/Dotfiles/scripts/sleep.sh 30",
      "off45": "~/Dotfiles/scripts/sleep.sh 45",
      "off60": "~/Dotfiles/scripts/sleep.sh 60",
      "cancel": "~/Dotfiles/scripts/sleep.sh cancel",
    },
  },
  "custom/lock": {
    "format": "\udb80\udf3e",   // padlock (nerd font): lock the screen with hyprlock, like Super+L
    "tooltip": false,
    "on-click": "loginctl lock-session"
  },
  "custom/suspend": {
    "format": "󰒲",
    "tooltip": false,
    "on-double-click": "systemctl suspend"
  },
  "custom/screenshot": {
    "format": "󰹑",
    "tooltip": false,
    "on-click": "grimblast copy area"
  },
  "custom/audio": {
    "format": "󰒝",
    "tooltip": false,
    "on-click": "~/Dotfiles/scripts/toggle-audio.sh"
  }

}
