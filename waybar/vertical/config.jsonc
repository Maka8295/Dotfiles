// Vertical layout: the normal config (../config.jsonc) with only the differences below.
// Switch layouts with ~/Dotfiles/scripts/waybar-toggle.sh
{
  "include": "~/Dotfiles/waybar/config.jsonc",

  "position": "left",
  "height": 0,
  // the 10px gap is drawn inside the bar (style.css) so the drop shadow fits;
  // -10 on the window side keeps the space reserved for the bar unchanged
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": -10,

  // stack the wide bits so the bar stays narrow
  "clock": {
    "format": "{:%H:%M\n%m/%d}",
    "justify": "center",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "months": "<span color='#7abfff'><b>{}</b></span>",
        "today": "<span color='#7abfff'><b>{}</b></span>",
      },
    },
  },
  // The bar is as wide as its widest module, so a wider volume number made the whole bar
  // grow. The digits stay full size (like the temperatures) and only the % sign is small
  // (9pt = 12px; sizes are in 1024ths of a point), so up to "99%" fits the space the bar
  // already has. 100%+ has no state class and style.css narrows its side margins instead.
  "pulseaudio": {
    "states": { "under-100": 99 },   // class on the module while the volume is <= 99
    "format": "{volume}<span font_size='9216'>%</span>\n{icon}",
    "format-bluetooth": "{volume}<span font_size='9216'>%</span>\n{icon}\uf294",   // \uf294 = bluetooth icon
    "justify": "center",
  },
}
